#!/usr/bin/env bash
# Zenbook Duo: rotate both panels with the device, and turn the top panel
# around for the person opposite when the laptop lies opened flat on a table
# (opened flat but tilted up, on the kickstand or in hand, is normal use).
#
# Follows iio-sensor-proxy's accelerometer orientation (normal, bottom-up,
# left-up, right-up) and the hinge sensor's opening angle, writes the
# resulting layout (one of those, or "sharing") to
# ~/.local/state/zenbook/rotation and reloads Hyprland;
# ~/.config/hypr/monitors.lua turns that into per-panel transforms and a
# stacked or side-by-side layout.
#
# Needs: iio-sensor-proxy, and the ASUS ISH firmware for the sensors.
# Started from ~/.config/hypr/autostart.lua.
#
# Touch ~/.local/state/zenbook/rotation-lock to hold the current layout.

exec 9>"${XDG_RUNTIME_DIR:-/tmp}/zenbook-duo-rotate-watch.lock"
flock -n 9 || exit 0

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/zenbook"
STATE="$STATE_DIR/rotation"
LOCK="$STATE_DIR/rotation-lock"
SETTLE=1.0      # an orientation reading must hold this long (seconds)
SHARE_ON=170    # hinge angle (degrees) at which sharing mode starts...
SHARE_OFF=160   # ...and below which it ends; the gap stops flicker at the edge
LEVEL_ON=15     # base tilt (degrees) at or under which it counts as lying flat...
LEVEL_OFF=25    # ...and over which it is tilted up again
POLL=0.5        # hinge poll interval (seconds)
mkdir -p "$STATE_DIR"

hinge_raw() {
  local d
  for d in /sys/bus/iio/devices/iio:device*; do
    if [[ $(<"$d/name") == hinge ]]; then
      # Channel 0 "hinge" is the opening angle, channel 2 "keyboard" the
      # base's tilt from level; raw values are degrees.
      echo "$d/in_angl0_raw $d/in_angl2_raw"
      return
    fi
  done 2>/dev/null
}
read -r HINGE BASE < <(hinge_raw)

# Keep workspace order matching the layout: the panel at 0x0 (the left one
# side by side, the upper one stacked) shows the lower-numbered of the two
# visible workspaces. Workspaces stay on the panel they were created on, so
# without this, turning the device moves "workspace 1" to the right.
order_workspaces() {
  local json first second
  json=$(hyprctl -j monitors 2>/dev/null) || return
  read -r first second < <(jq -r '
    (map(select(.x == 0 and .y == 0))[0].activeWorkspace.id // empty) as $p
    | (map(select(.x != 0 or .y != 0))[0].activeWorkspace.id // empty) as $s
    | "\($p) \($s)"' <<<"$json")
  [[ -n $first && -n $second ]] || return 0 # one panel (keyboard docked)
  ((second < first)) || return 0
  hyprctl dispatch 'hl.dsp.workspace.swap_monitors({ monitor1 = "eDP-1", monitor2 = "eDP-2" })' >/dev/null 2>&1
}

apply() {
  local want=$1
  [[ $want == "$applied" ]] && return
  [[ -e $LOCK ]] && return
  printf '%s\n' "$want" >"$STATE"
  hyprctl reload >/dev/null 2>&1
  applied=$want
  sleep 0.5
  order_workspaces
}

now_ms() { echo $((${EPOCHREALTIME/./} / 1000)); }

while true; do
  # 9>&- so the sensor monitor does not inherit the lock.
  stdbuf -oL monitor-sensor --accel 2>/dev/null 9>&- | {
    applied=$(cat "$STATE" 2>/dev/null || echo normal)
    orientation=$applied
    [[ $orientation == sharing ]] && orientation=normal
    sharing=0
    pending="" pending_since=0
    while true; do
      if read -r -t "$POLL" line; then
        case $line in
          *"orientation changed:"*) pending=${line##*: } ;;
          *"(orientation: "*) pending=${line#*orientation: }; pending=${pending%%,*} ;;
          *) continue ;;
        esac
        case $pending in normal | bottom-up | left-up | right-up) pending_since=$(now_ms) ;; *) pending="" ;; esac
      elif (($? <= 128)); then
        break # monitor-sensor exited; restart it
      fi

      # An orientation counts once it has held for SETTLE seconds.
      if [[ -n $pending ]] && (($(now_ms) - pending_since >= ${SETTLE%.*} * 1000)); then
        orientation=$pending
        pending=""
      fi

      if [[ -n $HINGE ]] && angle=$(<"$HINGE") && tilt=$(<"$BASE"); then
        ((tilt > 180)) && ((tilt = 360 - tilt)) # either way from level
        if ((sharing == 0 && angle >= SHARE_ON && tilt <= LEVEL_ON)); then
          sharing=1
        elif ((sharing == 1 && (angle <= SHARE_OFF || tilt >= LEVEL_OFF))); then
          sharing=0
        fi
      fi 2>/dev/null

      if ((sharing)); then apply sharing; else apply "$orientation"; fi
    done
  }
  sleep 5
done

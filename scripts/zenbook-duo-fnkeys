#!/usr/bin/env python3
"""Turn the Zenbook Duo keyboard's ASUS hotkey reports into real key events.

Once hid-asus has bound to the keyboard's vendor interface (see
zenbook-duo-hid-asus), the keyboard sends its brightness / keyboard-backlight
/ mic-mute keys as ASUS vendor reports (report id 0x5a, one code byte) on
usage page 0xFF31. hid-asus would map those itself, but this keyboard
declares the report as a single Usage 0x76 with variable data instead of the
usage array the driver expects, so nothing reaches input. This daemon reads
the raw reports and injects the equivalent keys through /dev/uinput.

Runs as root from zenbook-duo-fnkeys.service. Finds the interfaces itself
(USB 0b05:1cd7 when docked, Bluetooth 0b05:1cd8 when detached) and follows
them as they come and go.
"""
import fcntl, glob, os, select, struct, time

VENDOR = "0B05"
PRODUCTS = ("1CD7", "1CD8")
VENDOR_PAGE = bytes.fromhex("0631ff")
REPORT_ID = 0x5A

# ASUS hotkey code -> Linux key code (input-event-codes.h)
KEYS = {
    0x10: 224,  # KEY_BRIGHTNESSDOWN
    0x20: 225,  # KEY_BRIGHTNESSUP
    0x7C: 248,  # KEY_MICMUTE
    0xC7: 228,  # KEY_KBDILLUMTOGGLE
    0xC4: 230,  # KEY_KBDILLUMUP
    0xC5: 229,  # KEY_KBDILLUMDOWN
    0x6C: 142,  # KEY_SLEEP
    0x82: 212,  # KEY_CAMERA
    0x88: 247,  # KEY_RFKILL
    0x6A: 183,  # KEY_F13   (screenpad / second display toggle)
    0xB5: 140,  # KEY_CALC
}

EV_SYN, EV_KEY = 0, 1
UI_SET_EVBIT, UI_SET_KEYBIT = 0x40045564, 0x40045565
UI_DEV_SETUP, UI_DEV_CREATE = 0x405C5503, 0x5501


def open_uinput():
    fd = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
    fcntl.ioctl(fd, UI_SET_EVBIT, EV_KEY)
    for code in KEYS.values():
        fcntl.ioctl(fd, UI_SET_KEYBIT, code)
    # struct uinput_setup { struct input_id {u16 bustype, vendor, product, version}; char name[80]; u32 ff_effects_max }
    setup = struct.pack("HHHH80sI", 0x06, 0x0B05, 0x1CD7, 1, b"Zenbook Duo Keyboard Fn keys", 0)
    fcntl.ioctl(fd, UI_DEV_SETUP, setup)
    fcntl.ioctl(fd, UI_DEV_CREATE)
    return fd


def emit(ufd, code, value):
    now = time.time()
    sec, usec = int(now), int((now % 1) * 1e6)
    os.write(ufd, struct.pack("qqHHi", sec, usec, EV_KEY, code, value))
    os.write(ufd, struct.pack("qqHHi", sec, usec, EV_SYN, 0, 0))


def hotkey_nodes():
    found = []
    for node in glob.glob("/sys/class/hidraw/hidraw*"):
        try:
            uevent = open(f"{node}/device/uevent").read()
            hid_id = next(l for l in uevent.splitlines() if l.startswith("HID_ID=")).split("=")[1]
            _, vend, prod = hid_id.split(":")
            if vend[-4:].upper() != VENDOR or prod[-4:].upper() not in PRODUCTS:
                continue
            if VENDOR_PAGE not in open(f"{node}/device/report_descriptor", "rb").read():
                continue
            found.append("/dev/" + os.path.basename(node))
        except (OSError, StopIteration, ValueError):
            continue
    return sorted(found)


def main():
    ufd = open_uinput()
    fds = {}          # fd -> path
    held = {}         # fd -> key currently pressed
    last_scan = 0
    while True:
        if time.time() - last_scan > 2:
            last_scan = time.time()
            wanted = hotkey_nodes()
            for fd, path in list(fds.items()):
                if path not in wanted:
                    os.close(fd); fds.pop(fd); held.pop(fd, None)
            for path in wanted:
                if path not in fds.values():
                    try:
                        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
                        fds[fd] = path
                        print(f"watching {path}", flush=True)
                    except OSError:
                        pass
        if not fds:
            time.sleep(1); continue
        ready, _, _ = select.select(list(fds), [], [], 2)
        for fd in ready:
            try:
                data = os.read(fd, 64)
            except OSError:
                path = fds.pop(fd); held.pop(fd, None); os.close(fd)
                print(f"lost {path}", flush=True)
                continue
            if len(data) < 2 or data[0] != REPORT_ID:
                continue
            code = data[1]
            if code == 0:
                if fd in held:
                    emit(ufd, held.pop(fd), 0)
            elif code in KEYS:
                if fd in held:
                    emit(ufd, held.pop(fd), 0)
                emit(ufd, KEYS[code], 1)
                held[fd] = KEYS[code]
            else:
                print(f"unmapped ASUS hotkey code {code:#04x}", flush=True)


if __name__ == "__main__":
    main()

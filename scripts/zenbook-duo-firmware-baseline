#!/usr/bin/env bash
# Zenbook Duo: snapshot the firmware-side state that Linux can see, so that a
# later incident (e.g. the bottom panel going dark after a full battery
# drain, README section 2a) can be diffed against a known-good machine.
#
# usage: zenbook-duo-firmware-baseline [output-dir]
#        default: ~/.local/state/zenbook/firmware-baseline-YYYYMMDD
#
# Captures: firmware attributes exposed by the ASUS driver, the list of UEFI
# variables (names + sizes), the contents of the Asus* UEFI variables (hex),
# both panels' EDIDs, the kernel command line, and the BIOS version. Reading
# some UEFI variables needs root; those are skipped when not permitted.
set -euo pipefail
OUT="${1:-${XDG_STATE_HOME:-$HOME/.local/state}/zenbook/firmware-baseline-$(date +%Y%m%d)}"
mkdir -p "$OUT"

A=/sys/class/firmware-attributes/asus-armoury/attributes
if [[ -d $A ]]; then
  for d in "$A"/*/; do printf '%s=%s\n' "$(basename "$d")" "$(cat "$d/current_value" 2>/dev/null)"; done >"$OUT/asus-armoury.txt"
fi

V=/sys/firmware/efi/efivars
ls -l "$V" 2>/dev/null | awk 'NF>=9 {print $5, $9}' | sort -k2 >"$OUT/efivars-list.txt"
for f in "$V"/Asus*; do
  n=$(basename "$f"); n=${n%%-*}
  od -An -tx1 -v "$f" >"$OUT/$n.hex" 2>/dev/null || rm -f "$OUT/$n.hex"
done

for c in /sys/class/drm/card*-eDP-*; do
  name=$(basename "$c"); name=${name#card*-}
  cp "$c/edid" "$OUT/edid-$name.bin" 2>/dev/null || true
  od -An -tx1 -v "$c/edid" >"$OUT/edid-$name.hex" 2>/dev/null || true
done

cp /proc/cmdline "$OUT/cmdline.txt"
{ cat /sys/class/dmi/id/bios_version; cat /sys/class/dmi/id/bios_date; } >"$OUT/bios-version.txt" 2>/dev/null || true
uname -r >"$OUT/kernel.txt"

echo "Baseline written to $OUT:"
ls "$OUT"
echo "Compare two baselines with: diff -r <old> <new>"

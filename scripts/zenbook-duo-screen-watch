#!/usr/bin/env bash
# Zenbook Duo: sync the bottom panel (eDP-2) with the pogo-pin keyboard.
# Keyboard docked  -> bottom screen off (it's covered by the keyboard).
# Keyboard removed -> bottom screen on, per ~/.config/hypr/monitors.lua.
#
# Started from ~/.config/hypr/autostart.lua.
#
# Design notes:
# - Uses Omarchy's toggle mechanism (the same one clamshell mode uses):
#   Lua files in the toggles dir load on every config reload, AFTER user
#   config, so the disable rule survives any `hyprctl reload` and never
#   fights omarchy-hyprland-monitor-watch's recovery reloads. One reload
#   per dock/undock is the only modeset that happens.
# - The toggle file's existence IS the applied state - no Hyprland polling
#   (IPC stalls during modesets and misreads caused toggle storms).

# Only one instance: Hyprland can run autostart more than once (config reloads,
# shell restarts), and two watchers racing on the same modeset is exactly the
# kind of double enable/disable the xe display driver does not survive.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/zenbook-duo-screen-watch.lock"
flock -n 9 || exit 0

KB_VENDOR="0b05"
KB_PRODUCT="1cd7" # ASUS Zenbook Duo Keyboard (2026 / 144Hz model)
TOGGLE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/toggles/hypr/zenbook-duo-keyboard.lua"
DISABLE_RULE='hl.monitor({ output = "eDP-2", disabled = true })'

BOTTOM_BL="card0-eDP-2-backlight"
TOP_BL="/sys/class/backlight/intel_backlight"
# Set once the bottom panel's PHY is found wedged (README section 2b); the
# panel is then left disabled for the rest of this boot.
WEDGED="${XDG_RUNTIME_DIR:-/tmp}/zenbook-duo-screen-watch.wedged"
WEDGE_PATTERN='PHY B failed|DDI BUF B|pipe B\] flip_done timed out'

top_percent() {
  local cur max
  cur=$(<"$TOP_BL/brightness") max=$(<"$TOP_BL/max_brightness")
  (( max > 0 )) && echo $(( 100 * cur / max )) || echo 50
}

kb_state() {
  local dev
  for dev in /sys/bus/usb/devices/*/idVendor; do
    if [[ -r $dev && $(<"$dev") == "$KB_VENDOR" && $(<"${dev%idVendor}idProduct") == "$KB_PRODUCT" ]]; then
      echo attached
      return
    fi
  done
  echo absent
}

# Two consistent reads 1s apart; rides out pogo-contact bounce and the
# udev event storm from the keyboard's composite sub-devices.
stable_kb_state() {
  local a b
  while true; do
    a=$(kb_state)
    sleep 1
    b=$(kb_state)
    [[ $a == "$b" ]] && { echo "$a"; return; }
  done
}

shutting_down() {
  [[ $(systemctl is-system-running 2>/dev/null) == stopping ]]
}

# The xe driver cannot bring the bottom panel's PHY back up when the firmware
# did not light it at power-on (README section 2b). Once that has failed,
# every further modeset on that pipe stalls the compositor for 10 s, so stop
# touching the panel until the next boot and say so once.
wedged_in_log() {   # [since], default: the whole boot
  journalctl -k -b -q ${1:+--since "$1"} 2>/dev/null | grep -qE "$WEDGE_PATTERN"
}

mark_wedged() {
  : >"$WEDGED"
  echo "zenbook-duo-screen-watch: bottom panel PHY wedged; leaving eDP-2 disabled until reboot" >&2
  omarchy-notification-send -u critical "Bottom screen unavailable" \
    "Its display PHY failed to come back. Power off fully (not reboot) and power on with the keyboard off the laptop." >/dev/null 2>&1 ||
    notify-send "Bottom screen unavailable" "Power off fully and power on with the keyboard off the laptop." >/dev/null 2>&1
}

set_toggle() {
  if [[ $1 == attached ]]; then
    mkdir -p "${TOGGLE%/*}"
    printf '%s\n' "$DISABLE_RULE" >"$TOGGLE"
  else
    rm -f "$TOGGLE"
  fi
  hyprctl reload >/dev/null 2>&1
}

apply() {
  local state=$1 have=absent
  [[ -f $TOGGLE ]] && have=attached
  [[ $state == "$have" ]] && return
  if [[ $state == absent ]]; then
    # Leave the panel off if the system is going down (the re-enable would
    # stall the shutdown) or if this boot's PHY is already known to be wedged.
    shutting_down && return
    [[ -f $WEDGED ]] && return
  fi
  set_toggle "$state"
  if [[ $state == absent ]]; then
    # Re-enabling via reload doesn't always power the panel back up
    # (same reason omarchy's clamshell fires dpms after enabling).
    sleep 1
    hyprctl dispatch 'hl.dsp.dpms({ action = "enable", monitor = "eDP-2" })' >/dev/null 2>&1
    brightnessctl --device="$BOTTOM_BL" set "$(top_percent)%" >/dev/null 2>&1
    sleep 3
    if wedged_in_log -10s; then
      set_toggle attached   # one more 10 s stall, then the pipe is left alone
      mark_wedged
    fi
  fi
}

# A boot that started docked, or that inherited a wedged PHY from a warm
# reboot, already shows the signature in the kernel log. Otherwise clear the
# notification a previous boot may have left behind: Omarchy keeps critical
# notifications across logins, and a stale one would announce a wedge that
# the power reset has just fixed.
if [[ ! -f $WEDGED ]]; then
  if wedged_in_log; then
    mark_wedged
  else
    omarchy-notification-dismiss "Bottom screen unavailable" >/dev/null 2>&1 || true
  fi
fi

apply "$(stable_kb_state)"

while true; do
  # 9>&- so udevadm does not inherit the lock: an orphaned monitor would
  # otherwise keep the lock and stop the next watcher from starting.
  udevadm monitor -u -s usb 2>/dev/null 9>&- | {
    while true; do
      read -r _ || break               # EOF: udevadm exited; restart it
      while read -r -t 0.5 _; do :; done # drain the event burst
      apply "$(stable_kb_state)"
    done
  }
  sleep 5
done

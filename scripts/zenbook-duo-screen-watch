#!/usr/bin/env bash
# Zenbook Duo: sync the bottom panel (eDP-2) with the pogo-pin keyboard.
# Keyboard docked  -> bottom screen off (it's covered by the keyboard).
# Keyboard removed -> bottom screen on, per ~/.config/hypr/monitors.lua.
#
# Started from ~/.config/hypr/autostart.lua.
#
# Design notes:
# - Uses Omarchy's toggle mechanism (the same one clamshell mode uses):
#   Lua files in the toggles dir load on every config reload, AFTER user
#   config, so the disable rule survives any `hyprctl reload` and never
#   fights omarchy-hyprland-monitor-watch's recovery reloads. One reload
#   per dock/undock is the only modeset that happens.
# - The toggle file's existence IS the applied state - no Hyprland polling
#   (IPC stalls during modesets and misreads caused toggle storms).

# Only one instance: Hyprland can run autostart more than once (config reloads,
# shell restarts), and two watchers racing on the same modeset is exactly the
# kind of double enable/disable the xe display driver does not survive.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/zenbook-duo-screen-watch.lock"
flock -n 9 || exit 0

KB_VENDOR="0b05"
KB_PRODUCT="1cd7" # ASUS Zenbook Duo Keyboard (2026 / 144Hz model)
TOGGLE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/toggles/hypr/zenbook-duo-keyboard.lua"
DISABLE_RULE='hl.monitor({ output = "eDP-2", disabled = true })'

# How the bottom screen is put to sleep while the keyboard is docked:
#   backlight (default) - keep eDP-2 enabled, drive its backlight to 0. No
#                         modeset, so the xe driver never has to power the
#                         panel's PHY down and back up (which hard-hangs the
#                         machine on kernel 7.1 when it goes wrong, see README
#                         section 2a). Windows can still be placed there.
#   disable             - the original behaviour: disable the output through
#                         Omarchy's toggle mechanism (one modeset per dock and
#                         undock). Use only if the driver bug is fixed.
MODE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/zenbook/dock-mode"
MODE=$( [[ -r $MODE_FILE ]] && tr -d '[:space:]' <"$MODE_FILE" || echo backlight )
# One-shot override for experiments: consumed (deleted) on first use, so a
# boot that hard-hangs does not leave the risky mode armed for the next one.
MODE_ONCE_FILE="${MODE_FILE}-once"
if [[ -r $MODE_ONCE_FILE ]]; then
  MODE=$(tr -d '[:space:]' <"$MODE_ONCE_FILE")
  rm -f "$MODE_ONCE_FILE"
fi
DOCKED_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/zenbook/docked"
BOTTOM_BL="card0-eDP-2-backlight"
TOP_BL="/sys/class/backlight/intel_backlight"
# Layout of the bottom panel from monitors.lua, and where it is parked while
# docked: far enough that the cursor cannot cross onto it. Moving a monitor is
# compositor-side only, no modeset.
BOTTOM_POS="0x900"
BOTTOM_SCALE=2
PARK_POS="20000x20000"
PARK_WS=99   # the empty workspace Hyprland insists on keeping on the covered panel

bottom_workspaces() {
  hyprctl workspaces -j 2>/dev/null | python3 -c 'import sys,json; print(" ".join(str(w["id"]) for w in json.load(sys.stdin) if w["monitor"]=="eDP-2"))' 2>/dev/null
}

workspace_exists() {
  hyprctl workspaces -j 2>/dev/null | python3 -c "import sys,json; sys.exit(0 if any(w['id']==$1 for w in json.load(sys.stdin)) else 1)" 2>/dev/null
}

# Make the covered panel unreachable: park it out of cursor range, pin the
# numbered workspaces to the top panel, hand it whatever it already shows,
# and leave it an empty workspace under a number no keybind uses.
park_bottom() {
  hyprctl eval "hl.monitor({ output = \"eDP-2\", mode = \"preferred\", position = \"$PARK_POS\", scale = $BOTTOM_SCALE })" >/dev/null 2>&1
  hyprctl eval 'for i = 1, 10 do hl.workspace_rule({ workspace = tostring(i), monitor = "eDP-1" }) end' >/dev/null 2>&1
  local id
  for id in $(bottom_workspaces); do
    hyprctl dispatch "hl.dsp.workspace.move({ workspace = \"$id\", monitor = \"eDP-1\" })" >/dev/null 2>&1
  done
  for id in $(bottom_workspaces); do   # the one Hyprland just created to replace them
    [[ $id == "$PARK_WS" ]] && continue
    hyprctl dispatch "hl.dsp.workspace.change_id({ workspace = \"$id\", id = $PARK_WS })" >/dev/null 2>&1
    hyprctl dispatch "hl.dsp.workspace.rename({ workspace = \"$PARK_WS\", name = \"dock\" })" >/dev/null 2>&1
  done
  hyprctl dispatch 'hl.dsp.focus({ monitor = "eDP-1" })' >/dev/null 2>&1
}

# Bring it back below the top panel with workspace 2 on it, as at boot.
unpark_bottom() {
  hyprctl eval "hl.monitor({ output = \"eDP-2\", mode = \"preferred\", position = \"$BOTTOM_POS\", scale = $BOTTOM_SCALE })" >/dev/null 2>&1
  hyprctl eval 'hl.workspace_rule({ workspace = "2", monitor = "eDP-2" })' >/dev/null 2>&1
  if workspace_exists 2; then
    hyprctl dispatch 'hl.dsp.workspace.move({ workspace = "2", monitor = "eDP-2" })' >/dev/null 2>&1
  elif workspace_exists "$PARK_WS"; then
    hyprctl dispatch "hl.dsp.workspace.change_id({ workspace = \"$PARK_WS\", id = 2 })" >/dev/null 2>&1
    hyprctl dispatch 'hl.dsp.workspace.rename({ workspace = "2", name = "2" })' >/dev/null 2>&1
  fi
}

top_percent() {
  local cur max
  cur=$(<"$TOP_BL/brightness") max=$(<"$TOP_BL/max_brightness")
  (( max > 0 )) && echo $(( 100 * cur / max )) || echo 50
}

kb_state() {
  local dev
  for dev in /sys/bus/usb/devices/*/idVendor; do
    if [[ -r $dev && $(<"$dev") == "$KB_VENDOR" && $(<"${dev%idVendor}idProduct") == "$KB_PRODUCT" ]]; then
      echo attached
      return
    fi
  done
  echo absent
}

# Two consistent reads 1s apart; rides out pogo-contact bounce and the
# udev event storm from the keyboard's composite sub-devices.
stable_kb_state() {
  local a b
  while true; do
    a=$(kb_state)
    sleep 1
    b=$(kb_state)
    [[ $a == "$b" ]] && { echo "$a"; return; }
  done
}

apply() {
  local state=$1 have=absent
  if [[ $MODE == backlight ]]; then
    # Leftover from "disable" mode would keep eDP-2 off after a mode switch;
    # clear it so the next config load enables the panel normally.
    if [[ -f $TOGGLE ]]; then rm -f "$TOGGLE"; hyprctl reload >/dev/null 2>&1; fi
    [[ -f $DOCKED_STATE ]] && have=attached
    [[ $state == "$have" ]] && return
    mkdir -p "${DOCKED_STATE%/*}"
    if [[ $state == attached ]]; then
      : >"$DOCKED_STATE"
      brightnessctl --device="$BOTTOM_BL" set 0 >/dev/null 2>&1
      park_bottom
    else
      rm -f "$DOCKED_STATE"
      unpark_bottom
      brightnessctl --device="$BOTTOM_BL" set "$(top_percent)%" >/dev/null 2>&1
    fi
    return
  fi
  # disable mode: make sure the backlight-mode state file is not left over,
  # or zenbook-duo-brightness-sync would keep eDP-2 dark after an undock.
  if [[ -f $DOCKED_STATE ]]; then
    rm -f "$DOCKED_STATE"
    [[ $state == absent ]] && brightnessctl --device="$BOTTOM_BL" set "$(top_percent)%" >/dev/null 2>&1
  fi
  [[ -f $TOGGLE ]] && have=attached
  [[ $state == "$have" ]] && return
  if [[ $state == attached ]]; then
    mkdir -p "${TOGGLE%/*}"
    printf '%s\n' "$DISABLE_RULE" >"$TOGGLE"
  else
    rm -f "$TOGGLE"
  fi
  hyprctl reload >/dev/null 2>&1
  if [[ $state == absent ]]; then
    # Re-enabling via reload doesn't always power the panel back up
    # (same reason omarchy's clamshell fires dpms after enabling).
    sleep 1
    hyprctl dispatch 'hl.dsp.dpms({ action = "enable", monitor = "eDP-2" })' >/dev/null 2>&1
    brightnessctl --device="$BOTTOM_BL" set "$(top_percent)%" >/dev/null 2>&1
  fi
}

apply "$(stable_kb_state)"

while true; do
  # 9>&- so udevadm does not inherit the lock: an orphaned monitor would
  # otherwise keep the lock and stop the next watcher from starting.
  udevadm monitor -u -s usb 2>/dev/null 9>&- | {
    while true; do
      read -r _ || break               # EOF: udevadm exited; restart it
      while read -r -t 0.5 _; do :; done # drain the event burst
      apply "$(stable_kb_state)"
    done
  }
  sleep 5
done

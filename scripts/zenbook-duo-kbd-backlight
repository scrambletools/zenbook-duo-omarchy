#!/usr/bin/env python3
# Zenbook Duo (0b05:1cd7) keyboard backlight control over hidraw.
#
# Kernel 7.2's asus-wmi no longer registers asus::kbd_backlight (deferred
# to hid-asus, which lacks this device ID), so we send the keyboard's own
# backlight command: a 16-byte feature report 0x5a (ba c5 c4 <level>) on
# USB interface 4. The length matters - shorter reports are accepted by the
# kernel but ignored by the keyboard. The first write after idle can stall
# (EPIPE), so each write is retried once.
#
# Usage: zenbook-duo-kbd-backlight <0|1|2|3|up|down|cycle|off|restore|get>
#   0-3     set level and remember it
#   up/down step the remembered level (clamped 0-3)
#   cycle   step 0 -> 1 -> 2 -> 3 -> 0 (the backlight key)
#   off     level 0, remembered level kept (lock/screensaver use)
#   restore re-apply the remembered level (default 3)
#   get     print the remembered level
#
# Needs write access to the keyboard's hidraw nodes:
# /etc/udev/rules.d/70-zenbook-kbd-backlight.rules tags them uaccess.

import fcntl, os, sys, time

STATE = os.path.expanduser("~/.config/zenbook/kbd-backlight-level")

# The keyboard firmware auto-repeats the hotkey report (~5/s) while the key
# is held, as full press/release pairs. Step once on the first event, then
# swallow events until a quiet gap; every swallowed event refreshes the
# window so an entire hold collapses into one step.
DEBOUNCE_S = 0.5


def backlight_nodes():
    nodes = []
    base = "/sys/class/hidraw"
    for name in sorted(os.listdir(base)):
        dev = os.path.realpath(os.path.join(base, name, "device"))
        if "0B05:1CD7" in dev and ":1.4/" in dev:
            nodes.append(f"/dev/{name}")
    return nodes


def apply_level(level):
    report = bytes([0x5A, 0xBA, 0xC5, 0xC4, level] + [0] * 11)
    ok = False
    for path in backlight_nodes():
        try:
            fd = os.open(path, os.O_RDWR)
        except OSError:
            continue
        try:
            for _attempt in range(2):
                try:
                    fcntl.ioctl(fd, 0xC0004806 | (len(report) << 16), report)
                    ok = True
                    break
                except OSError:
                    time.sleep(0.05)
        finally:
            os.close(fd)
    return ok


def read_state(fd):
    """State file holds 'level last-step-timestamp'."""
    try:
        os.lseek(fd, 0, os.SEEK_SET)
        fields = os.read(fd, 64).decode().split()
        level = max(0, min(3, int(fields[0])))
        ts = float(fields[1]) if len(fields) > 1 else 0.0
        return level, ts
    except (OSError, ValueError, IndexError):
        return 3, 0.0


def write_state(fd, level, ts):
    os.lseek(fd, 0, os.SEEK_SET)
    os.truncate(fd, 0)
    os.write(fd, f"{level} {ts}\n".encode())


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else "restore"
    # Rapid key events spawn overlapping invocations; the lock makes each
    # read-modify-write of the level atomic.
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    fd = os.open(STATE, os.O_RDWR | os.O_CREAT, 0o644)
    fcntl.flock(fd, fcntl.LOCK_EX)
    level, last_ts = read_state(fd)

    if arg == "get":
        print(level)
        return 0
    if arg == "off":
        return 0 if apply_level(0) else 1
    if arg == "restore":
        return 0 if apply_level(level) else 1

    now = time.time()
    stepping = arg in ("up", "down", "cycle")
    if stepping and now - last_ts < DEBOUNCE_S:
        write_state(fd, level, now)  # firmware repeat: refresh window only
        return 0
    if arg == "up":
        level = min(3, level + 1)
    elif arg == "down":
        level = max(0, level - 1)
    elif arg == "cycle":
        level = (level + 1) % 4
    elif arg in ("0", "1", "2", "3"):
        level = int(arg)
    else:
        print("usage: zenbook-duo-kbd-backlight <0-3|up|down|cycle|off|restore|get>",
              file=sys.stderr)
        return 2

    if not apply_level(level):
        return 1
    # Only key-driven steps arm the debounce window; explicit sets do not.
    write_state(fd, level, now if stepping else 0.0)
    return 0


if __name__ == "__main__":
    sys.exit(main())

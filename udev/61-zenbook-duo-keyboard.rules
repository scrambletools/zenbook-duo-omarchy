# Zenbook Duo keyboard: hand the keyboard interface to hid-asus so the Fn keys
# work (see scripts/zenbook-duo-hid-asus). Fires when the interface lands on
# hid-generic, over USB (docked, 1cd7) or Bluetooth (detached, 1cd8).
# systemd-run detaches the rebind from the udev worker that is mid-bind.
# "add" covers a keyboard docked at power-on: it binds in the initramfs (for
# the disk-unlock prompt), where this rule does not exist, and its only later
# event is the "add" replayed by systemd-udev-trigger, with hid-generic
# already attached. A hot-plugged keyboard has no driver yet at "add", so
# only its "bind" matches.
ACTION=="add|bind", SUBSYSTEM=="hid", DRIVER=="hid-generic", ENV{HID_ID}=="*:00000B05:00001CD[78]", RUN+="/usr/bin/systemd-run --no-block --quiet /usr/local/bin/zenbook-duo-hid-asus %k"

# Zenbook Duo detachable keyboard (USB 0b05:1cd7 docked, Bluetooth 0b05:1cd8):
# its mute, volume, brightness, keyboard-backlight and mic-mute keys send
# plain F1/F2/F3, F5/F6, F4 and F10 (no consumer or vendor hotkey codes, and
# nothing at all with Fn held), so map those scancodes to the functions
# printed on the keys, for this keyboard only.
evdev:input:b0003v0B05p1CD7*
evdev:input:b0005v0B05p1CD8*
 KEYBOARD_KEY_7003a=mute
 KEYBOARD_KEY_7003b=volumedown
 KEYBOARD_KEY_7003c=volumeup
 KEYBOARD_KEY_7003d=kbdillumtoggle
 KEYBOARD_KEY_7003e=brightnessdown
 KEYBOARD_KEY_7003f=brightnessup
 KEYBOARD_KEY_70043=micmute
